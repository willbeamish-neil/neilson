
/**
 * Accommodation gallery â€” "Three ways to get after it"
 * Tab switching + carousel scroll controls.
 */
(function () {
  function initTabs(root) {
    var tabs = root.querySelectorAll('[data-accommodation-gallery-tab]');
    var panels = root.querySelectorAll('[data-accommodation-gallery-panel]');

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        var target = tab.getAttribute('data-accommodation-gallery-tab');

        tabs.forEach(function (t) {
          var isActive = t === tab;
          t.classList.toggle('is-active', isActive);
          t.setAttribute('aria-selected', String(isActive));
        });

        panels.forEach(function (panel) {
          var isActive = panel.getAttribute('data-accommodation-gallery-panel') === target;
          panel.classList.toggle('is-active', isActive);
          if (isActive) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });
      });
    });
  }

  function initCarousel(panel) {
    var track = panel.querySelector('[data-accommodation-gallery-track]');
    var prevBtn = panel.querySelector('[data-accommodation-gallery-prev]');
    var nextBtn = panel.querySelector('[data-accommodation-gallery-next]');
    if (!track || !prevBtn || !nextBtn) return;

    function scrollByCard(direction) {
      var card = track.querySelector('.resort-card');
      var step = card ? card.getBoundingClientRect().width + 16 : track.clientWidth * 0.8;
      track.scrollBy({ left: direction * step, behavior: 'smooth' });
    }

    function updateButtons() {
      var maxScroll = track.scrollWidth - track.clientWidth - 1;
      prevBtn.disabled = track.scrollLeft <= 0;
      nextBtn.disabled = track.scrollLeft >= maxScroll;
    }

    prevBtn.addEventListener('click', function () { scrollByCard(-1); });
    nextBtn.addEventListener('click', function () { scrollByCard(1); });
    track.addEventListener('scroll', updateButtons, { passive: true });
    window.addEventListener('resize', updateButtons);

    updateButtons();
  }

  function initAccommodationGallery(root) {
    initTabs(root);
    root.querySelectorAll('[data-accommodation-gallery-panel]').forEach(initCarousel);
  }

  window.initAccommodationGallery = initAccommodationGallery;

  document.addEventListener('DOMContentLoaded', function () {
    document.querySelectorAll('[data-accommodation-gallery]').forEach(initAccommodationGallery);
  });
})();
